{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [
      { "source": "/admin", "destination": "/index.html" },
      { "source": "/(.*)", "destination": "/index.html" }
    ],
    "functions": {
      "api/stripe-webhook.ts": {
        "memory": 128,
        "maxDuration": 10
      }
    }
  }